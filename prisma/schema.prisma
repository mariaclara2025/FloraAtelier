datasource db {
  provider = "sqlite"
  url      = "file:./flora_atelier.sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model ConfiguracaoFinanceira {
  id           Int   @id @default(1)
  valorHora    Float @default(25.0) @map("valor_hora")
  margemPadrao Float @default(40.0) @map("margem_padrao") // margem % sobre preço de venda
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  senha    String
  tipo     String   // 'Cliente' ou 'Admin'
  endereco String?
  telefone String?
  pedidos  Pedido[]
}

model Insumo {
  id            Int             @id @default(autoincrement())
  nome          String
  qtdTotal      Float           @map("qtd_total")
  qtdDisponivel Float           @default(0) @map("qtd_disponivel")
  custoTotal    Float           @map("custo_total")
  precoUnitario Float?          @map("preco_unitario")
  flores        FlorInsumo[]
  produtos      ProdutoInsumo[]
}

model Flor {
  id                Int            @id @default(autoincrement())
  nome              String
  tempoConfeccaoMin Int            @default(0) @map("tempo_confeccao_min")
  custoMaoDeObra    Float          @default(0.0) @map("custo_mao_de_obra")
  custoMateriais    Float          @default(0.0) @map("custo_materiais")
  custoTotal        Float          @default(0.0) @map("custo_total")
  insumos           FlorInsumo[]
  produtos          ProdutoFlor[]
}

model FlorInsumo {
  id         Int    @id @default(autoincrement())
  florId     Int    @map("flor_id")
  insumoId   Int    @map("insumo_id")
  quantidade Float
  flor       Flor   @relation(fields: [florId], references: [id], onDelete: Cascade)
  insumo     Insumo @relation(fields: [insumoId], references: [id])
}

model Produto {
  id               Int             @id @default(autoincrement())
  nome             String
  descricao        String?
  preco            Float           @default(0.0)
  precoManual      Boolean         @default(false) @map("preco_manual")
  custoProducao    Float           @default(0.0) @map("custo_producao")
  margemLucro      Float           @default(0.0) @map("margem_lucro")
  tempoMontagemMin Int             @default(0) @map("tempo_montagem_min")
  imagem           String?
  tamanho          String?
  corPrincipal     String?         @map("cor_principal")
  tipo             String          // 'Buquê Completo', 'Flor Individual', etc.
  flores           ProdutoFlor[]
  insumos          ProdutoInsumo[]
  itensPedido      PedidoItem[]
}

model ProdutoFlor {
  id         Int     @id @default(autoincrement())
  produtoId  Int     @map("produto_id")
  florId     Int     @map("flor_id")
  quantidade Int
  produto    Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  flor       Flor    @relation(fields: [florId], references: [id])
}

model ProdutoInsumo {
  id         Int     @id @default(autoincrement())
  produtoId  Int     @map("produto_id")
  insumoId   Int     @map("insumo_id")
  quantidade Float
  produto    Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  insumo     Insumo  @relation(fields: [insumoId], references: [id])
}

model Pedido {
  id            Int          @id @default(autoincrement())
  idCliente     Int          @map("id_cliente")
  status        String       @default("Em Análise")
  total         Float
  custoTotal    Float        @default(0.0) @map("custo_total")
  lucroEstimado Float        @default(0.0) @map("lucro_estimado")
  data          DateTime     @default(now())
  feedback          String?
  feedbackPublicado Boolean  @default(false)
  cliente       Usuario      @relation(fields: [idCliente], references: [id])
  itens         PedidoItem[]
}

model PedidoItem {
  id            Int     @id @default(autoincrement())
  pedidoId      Int     @map("pedido_id")
  produtoId     Int     @map("produto_id")
  quantidade    Int
  precoUnitario Float   @map("preco_unitario")
  custoUnitario Float   @default(0.0) @map("custo_unitario")
  pedido        Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto       Produto @relation(fields: [produtoId], references: [id])
}

model Custo {
  id        Int      @id @default(autoincrement())
  descricao String
  categoria String   @default("Operacional") // 'Insumo', 'Embalagem', 'Fixo', 'Operacional'
  valor     Float
  data      DateTime @default(now())
}
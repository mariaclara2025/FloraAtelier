<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flora Atelier - Gerenciamento de Pedidos</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f5f0ff',
                            100: '#ebdeff',
                            200: '#dac2ff',
                            300: '#c199ff',
                            400: '#a366ff',
                            500: '#8b33ff',
                            600: '#751ae6',
                            700: '#6010bf',
                            800: '#500e9e',
                            950: '#1b003a',
                        },
                        accent: {
                            pink: '#f472b6',
                            lavender: '#e9d5ff',
                            emerald: '#10b981',
                            rose: '#f43f5e'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif']
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-slate-50 font-sans text-slate-800 antialiased min-h-screen flex flex-col justify-between">

    <!-- Barra de Navegação -->
    <nav class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-purple-100 px-6 py-4">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <span class="text-2xl">🔮</span>
                <span class="font-serif font-extrabold text-xl tracking-wide bg-gradient-to-r from-brand-600 to-accent-pink bg-clip-text text-transparent">Flora Admin</span>
            </div>
            <div class="flex items-center space-x-4">
                <!-- Botão de Voltar ao Dashboard -->
                <a href="/dashboard" class="bg-slate-100 text-slate-600 hover:bg-slate-200 px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition-colors border border-slate-200">
                    ← Voltar ao Painel
                </a>
                
                <span class="text-xs font-medium text-slate-500 hidden sm:inline">Olá, <strong class="text-slate-700">{{ nome_usuario }}</strong></span>
                <a href="/logout" class="text-xs font-semibold text-slate-400 hover:text-accent-rose transition-colors">Sair</a>
            </div>
        </div>
    </nav>

    <!-- Conteúdo Principal -->
    <main class="max-w-6xl mx-auto px-6 py-8 w-full flex-grow space-y-8">
        
        <section class="bg-white border border-purple-100 rounded-3xl shadow-sm overflow-hidden">
            <div class="p-6 md:p-8 flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-slate-100 gap-4">
                <div>
                    <h2 class="font-serif text-xl font-bold text-slate-900">Acompanhamento de Pedidos</h2>
                    <p class="text-xs text-slate-400">Acompanhe os pedidos recentes, valores e atualize o status para o cliente.</p>
                </div>
                <div class="bg-brand-50 text-brand-700 px-4 py-2 rounded-xl text-xs font-semibold border border-brand-100">
                    Total de Pedidos: {{ pedidos|length }}
                </div>
            </div>

            <!-- Tabela de Pedidos -->
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50/70 border-b border-slate-100 text-slate-400 text-[11px] font-bold uppercase tracking-wider">
                            <th class="py-4 px-6">ID Pedido</th>
                            <th class="py-4 px-6">Data</th>
                            <th class="py-4 px-6">Cliente</th>
                            <th class="py-4 px-6">Valor Total</th>
                            <th class="py-4 px-6">Atualizar Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm text-slate-700">
                        {% for pedido in pedidos %}
                        <tr class="hover:bg-slate-50/40 transition-colors border-b border-slate-100">
                            <!-- Coluna ID -->
                            <td class="py-4 px-6 font-mono text-xs text-slate-400">#{{ pedido.id }}</td>
                            
                            <!-- Coluna Data -->
                            <td class="py-4 px-6 text-xs text-slate-500">{{ pedido.data }}</td>
                            
                            <!-- Coluna Cliente -->
                            <td class="py-4 px-6 font-semibold text-slate-900">{{ pedido.nome_cliente }}</td>
                            
                            <!-- Coluna Valor Total -->
                            <td class="py-4 px-6 font-medium text-slate-900">R$ {{ "%.2f"|format(pedido.total) }}</td>
                            
                            <!-- Coluna Form Status -->
                            <td class="py-4 px-6">
                                <form action="/atualizar_pedido/{{ pedido.id }}" method="POST" class="flex items-center space-x-2">
                                    <select name="status" class="bg-slate-50 border border-slate-200 text-slate-700 text-xs rounded-lg focus:ring-brand-500 focus:border-brand-500 block w-full p-2 outline-none cursor-pointer">
                                        <option value="Pendente" {% if pedido.status == 'Pendente' %}selected{% endif %}>Pendente</option>
                                        <option value="Pagamento Confirmado" {% if pedido.status == 'Pagamento Confirmado' %}selected{% endif %}>Pagamento Confirmado</option>
                                        <option value="Em Produção" {% if pedido.status == 'Em Produção' %}selected{% endif %}>Em Produção</option>
                                        <option value="Concluído" {% if pedido.status == 'Concluído' %}selected{% endif %}>Concluído</option>
                                        <option value="Saindo para Entrega" {% if pedido.status == 'Saindo para Entrega' %}selected{% endif %}>Saindo para Entrega</option>
                                        <option value="Entregue" {% if pedido.status == 'Entregue' %}selected{% endif %}>Entregue</option>
                                    </select>
                                    
                                    <button type="submit" title="Salvar Status" class="bg-brand-500 hover:bg-brand-600 text-white p-2 rounded-lg transition-colors flex-shrink-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                        </svg>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="5" class="py-12 text-center text-xs text-slate-400 italic">
                                Nenhum pedido encontrado no sistema. 😢
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <!-- Rodapé -->
    <footer class="text-slate-400 text-[11px] py-6 text-center border-t border-slate-100 bg-white mt-12">
        &copy; 2026 Flora Atelier • Ambiente de Pagamento e Pedido Seguro.
    </footer>

</body>
</html>